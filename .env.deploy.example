# Synapmsg — Configuración para deploy
# Copia este archivo a .env.deploy y completa los valores
# NO subas .env.deploy a Git (ya está en .gitignore)

# === NEON (PostgreSQL serverless) ===
# Obtenlo de: https://neon.tech → tu proyecto → Connection Details
NEON_DATABASE_URL=postgresql://synapmsg_owner:npg_xxxxxxxxxxxx@ep-xxxxxxxx-pooler.us-east-2.aws.neon.tech/synapmsg?sslmode=require

# === JWT SECRET ===
# Genera uno con: openssl rand -hex 32
JWT_SECRET=

# === DEEPL API ===
# Obtenlo de: https://www.deepl.com/pro#developer
# Plan Free: termina en :fx
DEEPL_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:fx

# === GITHUB REPO ===
# Crea un repo vacío en GitHub y pega la URL aquí
GITHUB_REPO_URL=https://github.com/MANOLOGIORDANO/synapmsg.git

# === CLOUDFLARE R2 (opcional, para multimedia) ===
# Obtenlo de: Cloudflare Dashboard → R2 → Manage R2 API Tokens
# Si no lo configuras, la app funcionará pero sin almacenamiento de archivos
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=synapmsg-media
R2_PUBLIC_URL=https://media.synapmsg.ai
