// Prisma schema for Synapmsg
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────────────────────────────────────
// User
// ───────────────────────────────────────────────────────────
model User {
  id                   String              @id @default(uuid()) @db.Uuid
  /// Optional — existing accounts keep email; anonymous bootstrap may be null.
  email                String?             @unique
  username             String              @unique
  name                 String
  passwordHash         String
  /// 10-digit find-me number (not a phone / SIM). Digits only, no leading 0.
  privateNumber        String?             @unique
  /// If false, search-by-number does not return this profile.
  privateNumberShared  Boolean             @default(false)
  preferredLanguage    String              @default("es")
  // "cloud" | "on-device" — validated at the API layer.
  // (Prisma enums disallow hyphens, so we store as String.)
  preferredTranslateMode String            @default("cloud")
  // "free" | "premium"
  plan                 String              @default("free")
  planExpiresAt        DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  pushToken            String?
  lastSeenAt           DateTime?
  mediaBytesUsed       BigInt              @default(0)
  translationsToday    Int                 @default(0)
  translationsDayKey   String              @default("")
  lastActiveAt         DateTime?
  fido2Enforced        Boolean             @default(false)
  recoveryCodesHash    String?             // JSON array of argon2 hashes (FIDO2 one-time codes)
  /// Account recovery passphrase (12-char): argon2 hash only — never plaintext.
  accountRecoveryHash       String?
  accountRecoveryCreatedAt  DateTime?
  /// User confirmed they wrote the code down (shown once at signup).
  accountRecoveryConfirmed  Boolean             @default(false)
  decoyUserId          String?             @db.Uuid
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  chatParticipants   ChatParticipant[]
  messages           Message[]
  reactions          MessageReaction[]
  scheduledMessages  ScheduledMessage[]
  glossaryEntries    GlossaryEntry[]
  devices            DeviceIdentity[]
  trustedLoginDevices TrustedLoginDevice[]
  ownedBots          Bot[]               @relation("BotOwner")
  botIdentity        Bot?                @relation("BotIdentity")
  pollsCreated       ChatPoll[]

  @@index([email])
  @@index([username])
  @@index([privateNumber])
  @@index([lastActiveAt])
  @@map("users")
}

/// Permanent ledger of Private Numbers — never reassigned, even after account delete.
model PrivateNumberLedger {
  privateNumber String   @id
  /// User that first received this number (informational; may be deleted later).
  firstUserId   String?  @db.Uuid
  createdAt     DateTime @default(now())

  @@map("private_number_ledger")
}

// ───────────────────────────────────────────────────────────
// Bot API (Fase 5) — Telegram-inspired
// ───────────────────────────────────────────────────────────
model Bot {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String   @db.Uuid
  /// User row that sends as this bot (synthetic account).
  botUserId   String   @unique @db.Uuid
  token       String   @unique
  username    String   @unique
  name        String
  webhookUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User         @relation("BotOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  botUser User         @relation("BotIdentity", fields: [botUserId], references: [id], onDelete: Cascade)
  updates BotUpdate[]

  @@index([ownerId])
  @@index([token])
  @@map("bots")
}

model BotUpdate {
  id          String   @id @default(uuid()) @db.Uuid
  botId       String   @db.Uuid
  /// Monotonic per-bot update id for getUpdates offset.
  updateId    Int
  payloadJson String
  createdAt   DateTime @default(now())

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([botId, updateId])
  @@index([botId, updateId])
  @@map("bot_updates")
}

// Public key material for future Signal/libsignal sessions.
// Private keys NEVER leave the device (client SecureStore).
model DeviceIdentity {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  deviceId        String
  identityKeyPub  String
  signedPreKeyPub String
  signedPreKeyId  Int      @default(1)
  /// Signature of signedPreKeyPub by identity key (Signal Protocol)
  signedPreKeySig String   @default("")
  preKeysJson     String   @default("[]") // JSON array of { keyId, publicKey }
  registrationId  Int
  /// libsignal (default) | synapmsg-pq-v1 (legacy, receive-only on clients)
  protocol        String   @default("libsignal")
  // ML-KEM768 public key (base64) — unused for new libsignal sessions
  pqKemPub        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("device_identities")
}

model KeyTransparencyEntry {
  id             String   @id @default(uuid()) @db.Uuid
  seq            Int      @unique
  userId         String   @db.Uuid
  identityKeyPub String
  hash           String
  prevHash       String
  createdAt      DateTime @default(now())

  @@index([userId])
  @@map("key_transparency_log")
}

model WebAuthnCredential {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  credentialId String   @unique
  publicKey    String
  counter      Int      @default(0)
  transports   String   @default("[]")
  label        String   @default("Passkey")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@map("webauthn_credentials")
}

/// Installations that already passed FIDO2 (or first enroll). New phones must assert again.
model TrustedLoginDevice {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  deviceInstallId String
  label           String   @default("")
  createdAt       DateTime @default(now())
  lastSeenAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceInstallId])
  @@index([userId])
  @@map("trusted_login_devices")
}

model GlossaryEntry {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  source    String
  target    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source])
  @@index([userId])
  @@map("glossary_entries")
}

// ───────────────────────────────────────────────────────────
// Chat
// ───────────────────────────────────────────────────────────
model Chat {
  id        String   @id @default(uuid()) @db.Uuid
  type      ChatType @default(single)
  name      String?
  // "cloud" | "e2e" — default E2E (absolute security); cloud = sync+MT
  encryptionMode String @default("e2e")
  /// Legacy windows: 0 | 1 | 6 | 12 | 24 (horas). Prefer disappearSeconds.
  disappearHours Int @default(0)
  /// Autodestrucción bilateral en segundos: 0 | 30 | 3600 | 86400 | 604800
  disappearSeconds Int @default(0)
  disappearText  Boolean @default(true)
  disappearImage Boolean @default(true)
  disappearAudio Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants      ChatParticipant[]
  messages          Message[]
  scheduledMessages ScheduledMessage[]
  polls             ChatPoll[]

  @@index([updatedAt])
  @@map("chats")
}

enum ChatType {
  single
  group
}

// ───────────────────────────────────────────────────────────
// ChatParticipant - join table between Chat and User
// ───────────────────────────────────────────────────────────
model ChatParticipant {
  id         String           @id @default(uuid()) @db.Uuid
  chatId     String           @db.Uuid
  userId     String           @db.Uuid
  role       ParticipantRole  @default(member)
  joinedAt   DateTime         @default(now())
  lastReadAt DateTime?
  // "Vaciar chat" for this user only — hide messages at/before this timestamp
  clearedAt  DateTime?

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([userId])
  @@index([chatId])
  @@map("chat_participants")
}

enum ParticipantRole {
  admin
  member
}

// ───────────────────────────────────────────────────────────
// Message
// ───────────────────────────────────────────────────────────
model Message {
  id                 String   @id @default(uuid()) @db.Uuid
  chatId             String   @db.Uuid
  senderId           String   @db.Uuid
  originalText       String
  originalLanguage   String
  translatedText     String?
  translatedLanguage String?
  isTranslated       Boolean  @default(false)
  mediaUrl           String?
  mediaType          String?  // "image" | "file" | "audio" | null
  // Scaffold for E2E payloads (null while encryptionMode=cloud)
  ciphertext         String?
  ciphertextType     Int?
  isE2e              Boolean  @default(false)
  replyToId          String?  @db.Uuid
  editedAt           DateTime?
  deletedAt          DateTime?
  /// Autodestrucción bilateral (ambos dispositivos).
  expiresAt          DateTime?
  /// Foto/audio de una sola vista/escucha.
  viewOnce           Boolean  @default(false)
  viewOnceOpenedAt   DateTime?
  createdAt          DateTime @default(now())

  chat      Chat              @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender    User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo   Message?          @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[]         @relation("MessageReplies")
  reactions          MessageReaction[]
  recipientCiphers   MessageRecipientCipher[]

  @@index([chatId, createdAt])
  @@index([senderId])
  @@index([chatId])
  @@index([replyToId])
  @@index([expiresAt])
  @@map("messages")
}

/// Per-member E2E envelope for group chats (fan-out libsignal).
model MessageRecipientCipher {
  id               String   @id @default(uuid()) @db.Uuid
  messageId        String   @db.Uuid
  recipientUserId  String   @db.Uuid
  ciphertext       String
  ciphertextType   Int      @default(3)
  createdAt        DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, recipientUserId])
  @@index([recipientUserId])
  @@map("message_recipient_ciphers")
}

model MessageReaction {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@map("message_reactions")
}

model ScheduledMessage {
  id        String   @id @default(uuid()) @db.Uuid
  chatId    String   @db.Uuid
  senderId  String   @db.Uuid
  text      String
  mediaUrl  String?
  mediaType String?
  sendAt    DateTime
  createdAt DateTime @default(now())

  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([sendAt])
  @@index([chatId])
  @@index([senderId])
  @@map("scheduled_messages")
}

model ChatPoll {
  id              String   @id @default(uuid()) @db.Uuid
  chatId          String   @db.Uuid
  creatorId       String   @db.Uuid
  question        String
  anonymous       Boolean  @default(false)
  quiz            Boolean  @default(false)
  correctOptionId String?  @db.Uuid
  messageId       String?  @unique @db.Uuid
  createdAt       DateTime @default(now())

  chat    Chat             @relation(fields: [chatId], references: [id], onDelete: Cascade)
  creator User             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  options ChatPollOption[]
  votes   ChatPollVote[]

  @@index([chatId])
  @@map("chat_polls")
}

model ChatPollOption {
  id     String @id @default(uuid()) @db.Uuid
  pollId String @db.Uuid
  text   String
  sort   Int    @default(0)
  votes  ChatPollVote[]

  poll ChatPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@index([pollId])
  @@map("chat_poll_options")
}

model ChatPollVote {
  id        String   @id @default(uuid()) @db.Uuid
  pollId    String   @db.Uuid
  optionId  String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  poll   ChatPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option ChatPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([optionId])
  @@map("chat_poll_votes")
}
