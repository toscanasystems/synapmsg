{
  "name": "synapmsg-api",
  "version": "1.0.0",
  "description": "Synapmsg backend - messaging app with real-time translation via DeepL",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "dev:watch": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push --skip-generate",
    "prisma:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/messages/privateEnvelope.test.js dist/lib/jwtSecret.test.js",
    "test:all": "npm run build && node --test \"dist/__tests__/**/*.test.js\"",
    "test:private-db": "npm run build && node scripts/test-private-db.js",
    "prove:private": "npm run build && node scripts/prove-private-no-plaintext.js",
    "prove:signal": "node scripts/prove-signal-two-accounts.js"
  },
  "keywords": [
    "synapmsg",
    "messaging",
    "translation",
    "deepl",
    "websocket"
  ],
  "author": "Synapmsg",
  "license": "MIT",
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@noble/post-quantum": "^0.7.1",
    "@prisma/client": "^5.22.0",
    "@simplewebauthn/server": "^14.1.0",
    "argon2": "^0.41.1",
    "axios": "^1.7.7",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "stripe": "^17.7.0",
    "svix": "^2.5.0",
    "tweetnacl": "^1.0.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.6",
    "@types/ws": "^8.5.13",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true,
    "bcrypt@5.1.1": true
  }
}
