# ───────────────────────────────────────────────────────────
# Synapmsg API - Environment Variables
# Copy this file to `.env` and fill in real values
# ───────────────────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# Database (Supabase / PostgreSQL connection string)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/synapmsg?schema=public"

# JWT
# Use a long, random, secret string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET="change-me-to-a-long-random-secret-string"
JWT_EXPIRES_IN="7d"

# DeepL API (Free tier)
# Get your key at https://www.deepl.com/pro-api
# Free keys end with ":fx"
DEEPL_API_KEY="your-deepl-api-key:fx"
DEEPL_API_URL="https://api-free.deepl.com/v2/translate"

# CORS (comma-separated origins, or "*" to allow all)
CORS_ORIGIN="*"

# Bcrypt
BCRYPT_ROUNDS=10
