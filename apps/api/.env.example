# ───────────────────────────────────────────────────────────
# Synapmsg API - Environment Variables
# Copy to `.env`. Root template: ../../.env.example
# Local infra: docker compose up -d (Postgres/Redis/MinIO)
# ───────────────────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# Database (Neon in prod; local compose defaults below)
DATABASE_URL="postgresql://synapmsg:synapmsg@localhost:5432/synapmsg?schema=public"
DIRECT_URL="postgresql://synapmsg:synapmsg@localhost:5432/synapmsg?schema=public"

# JWT
JWT_SECRET="change-me-to-a-long-random-secret-string"
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS=10

# DeepL
DEEPL_API_KEY="your-deepl-api-key:fx"
DEEPL_API_URL="https://api-free.deepl.com/v2/translate"

# CORS
CORS_ORIGIN="*"

# Redis (Fase 2+ fanout / rate limits)
REDIS_URL="redis://localhost:6379"

# Media (MinIO local or R2 via worker)
R2_PUBLIC_URL="http://localhost:9000/synapmsg-media"
R2_UPLOAD_SECRET="change-me-upload-secret"

# Recurrente (preferred LatAm billing) — https://docs.recurrente.com
RECURRENTE_SECRET_KEY=
RECURRENTE_PUBLIC_KEY=
RECURRENTE_WEBHOOK_SECRET=
# Optional: existing product/price in dashboard (else inline recurring item)
RECURRENTE_PRODUCT_ID=
RECURRENTE_PRICE_ID=
RECURRENTE_PREMIUM_CENTS=499
RECURRENTE_PREMIUM_CURRENCY=USD
RECURRENTE_SUCCESS_URL=https://synapmsg.ai/billing/success/
RECURRENTE_CANCEL_URL=https://synapmsg.ai/billing/cancel/

# Stripe (optional fallback — prefer Recurrente)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MONTHLY=

# Call media engine (Synap owns invite/accept/end over WS)
# jitsi = SFU via External API (default, better NAT); webrtc = P2P fallback
SYNAP_CALL_ENGINE=jitsi
SYNAP_JITSI_DOMAIN=meet.jit.si
# Optional own TURN (comma-separated URLs). If unset, openrelay fallback is used for P2P.
# SYNAP_TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:443
# SYNAP_TURN_USERNAME=
# SYNAP_TURN_CREDENTIAL=

# Security feature flags (roadmap)
E2E_REQUIRED_DEFAULT=false
PQ_HYBRID_ENABLED=false
DURESS_ENABLED=false
