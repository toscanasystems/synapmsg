# ─────────────────────────────────────────────────────────────
# Synapmsg — root env example (dev / compose)
# Copy to `.env`. Never commit real secrets.
# Per-app overrides: apps/api/.env , apps/mobile/.env
# ─────────────────────────────────────────────────────────────

# ── Compose / local infra ────────────────────────────────────
POSTGRES_USER=synapmsg
POSTGRES_PASSWORD=synapmsg
POSTGRES_DB=synapmsg
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=synapmsg
MINIO_ROOT_PASSWORD=synapmsgsecret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=synapmsg-media

# ── API (mirror into apps/api/.env) ──────────────────────────
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://synapmsg:synapmsg@localhost:5432/synapmsg?schema=public
DIRECT_URL=postgresql://synapmsg:synapmsg@localhost:5432/synapmsg?schema=public
# REQUIRED (≥32 chars). No code fallback — API will not start without it.
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
CORS_ORIGIN=http://localhost:3001,http://localhost:8081,*

# Translation
DEEPL_API_KEY=your-deepl-api-key:fx
DEEPL_API_URL=https://api-free.deepl.com/v2/translate

# Redis (sessions / rate-limit / wipe fanout — Fase 2+)
REDIS_URL=redis://localhost:6379

# Object storage (local MinIO or Cloudflare R2)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=synapmsg
S3_SECRET_ACCESS_KEY=synapmsgsecret
S3_BUCKET=synapmsg-media
S3_FORCE_PATH_STYLE=true
R2_PUBLIC_URL=http://localhost:9000/synapmsg-media
R2_UPLOAD_SECRET=change-me-upload-secret

# Stripe (optional until keys exist)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MONTHLY=

# Push (Expo)
EXPO_ACCESS_TOKEN=

# ── Mobile (apps/mobile/.env) ────────────────────────────────
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
EXPO_PUBLIC_WS_URL=ws://10.0.2.2:3000/ws

# ── Security roadmap flags (Fase 1+) ─────────────────────────
E2E_REQUIRED_DEFAULT=false
PQ_HYBRID_ENABLED=false
KTL_PUBLIC_URL=
FIDO2_RP_ID=localhost
FIDO2_ORIGIN=http://localhost:3000
DURESS_ENABLED=false
DEAD_MANS_SWITCH_ENABLED=false

# ── Ops ──────────────────────────────────────────────────────
SUPPORT_EMAIL=administrador@toscanasystems.com
PUBLIC_WEB_URL=https://synapmsg.ai
PUBLIC_API_URL=https://api.synapmsg.ai
